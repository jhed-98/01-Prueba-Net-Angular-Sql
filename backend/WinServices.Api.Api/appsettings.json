{
  "AllowedHosts": "*",
  "App": {
    "Version": "1.0.0"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "WinServices.Api",
    "Audience": "WinServices.ApiUsers",
    "ExpiryMinutes": "1440"
  },
  "Security": {
    "ApiKey": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "RabbitMQ": {
    "Host": "",
    "Port": "",
    "Username": "",
    "Password": "",
    "VirtualHost": "",
    "LogsExchange": ""
  },
  "ExternalServices": {
    "MiApi": {
      "BaseUrl": ""
    },
    "ExampleApi": {
      "BaseUrl": ""
    }
  },
  "OpenTelemetry": {
    "ServiceName": "",
    "OtlpEndpoint": ""
  },
  "ApiVersioning": {
    "DefaultMajorVersion": 1,
    "DefaultMinorVersion": 0
  }
}
