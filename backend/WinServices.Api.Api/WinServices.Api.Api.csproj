<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinServices.Api.Infrastructure\WinServices.Api.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <!-- JWT Bearer — necesario aunque sea SDK.Web en .NET 10 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- OpenAPI nativo .NET 10 + Scalar UI (reemplaza Swashbuckle, incompatible con OpenApi 2.0) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.6.1" />
    <!-- Logging estructurado -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- Enriquece logs con TraceId y SpanId del Activity de OpenTelemetry activo -->
    <PackageReference Include="Serilog.Enrichers.OpenTelemetry" Version="1.0.1" />
    <!-- Sink para enviar logs a RabbitMQ (canal durable de observabilidad) -->
    <PackageReference Include="Serilog.Sinks.RabbitMQ" Version="8.0.0" />
    <!-- Trazas distribuidas: instrumentación + exporter OTLP (Jaeger/OpenSearch) -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
  </ItemGroup>
</Project>
