# Application Environment
ASPNETCORE_ENVIRONMENT=Development
App__Version=1.0.0

# =============================================================================
# OBSERVABILIDAD — TODAS las claves son OPCIONALES.
# Si dejas una clave vacía, la aplicación arranca igual SIN ese servicio y /health
# reporta menos checks. Puedes correr la plantilla por sí sola, sin dependencias.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Connection (OPCIONAL)
# Si se deja vacío: la app arranca sin BD y sin el health check "database".
# -----------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=crm_test;Uid=root;Pwd=secret;

# JWT Authentication (OPCIONAL — la app arranca sin Secret)
# Si se deja vacío: no hay /login funcional ni validación de tokens; la app arranca igual.
JwtSettings__Secret=SuperSecretKeyForDevelopmentAndTesting123!!
JwtSettings__Issuer=your_issuer
JwtSettings__Audience=your_audience

# Security / API Key (OPCIONAL — middleware X-Api-Key)
# Si se deja vacío: la validación de X-Api-Key se omite (opt-in).
Security__ApiKey=

# -----------------------------------------------------------------------------
# Redis Cache (OPCIONAL)
# Si se deja vacío: se omite ICacheService y el health check "redis".
# -----------------------------------------------------------------------------
Redis__ConnectionString=localhost:6379

# -----------------------------------------------------------------------------
# RabbitMQ (OPCIONAL — canal durable de logs y/o mensajería)
# Si RabbitMQ__Host se deja vacío:
#   - No se registra el sink de logs a RabbitMQ en Program.cs.
#   - IMessageBus cae a NoOpMessageBus (no-op).
#   - No hay health check "rabbitmq".
# -----------------------------------------------------------------------------
RabbitMQ__Host=localhost
RabbitMQ__Port=5672
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__VirtualHost=/
RabbitMQ__LogsExchange=logs_exchange

# -----------------------------------------------------------------------------
# OpenTelemetry (OPCIONAL — trazas distribuidas a Jaeger)
# Si OpenTelemetry__OtlpEndpoint se deja vacío: OTel instrumenta pero NO exporta.
# La app funciona sin Jaeger.
# -----------------------------------------------------------------------------
OpenTelemetry__ServiceName=WinServices.ApiAPI
OpenTelemetry__OtlpEndpoint=http://jaeger:4317

# -----------------------------------------------------------------------------
# Servicios externos (OPCIONAL — solo si tu proyecto consume APIs externas)
# Regístralos en DI de forma condicional: solo si la URL tiene valor.
# -----------------------------------------------------------------------------
# ExternalServices__MiApi__BaseUrl=https://api.ejemplo.com

# Kestrel Server
Kestrel__Endpoints__Http__Url=http://+:5000

# API Versioning
ApiVersioning__DefaultMajorVersion=1
ApiVersioning__DefaultMinorVersion=0
