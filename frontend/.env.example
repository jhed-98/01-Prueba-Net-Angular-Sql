# ==============================================================================
# WIN SERVICES WEB TEMPLATE — VARIABLES DE ENTORNO
# ==============================================================================
# REGLA DE SEGURIDAD CRÍTICA:
# El frontend se ejecuta en el navegador del cliente. NUNCA coloques contraseñas,
# tokens secretos privados o credenciales de base de datos en este archivo.
# Solo variables con el prefijo "WIN_APP_" serán transferidas a la aplicación Angular.
# ==============================================================================

# Modo de simulación / offline
# true  = Utiliza MockService con MockStore en memoria (sin requerir backend)
# false = Utiliza HttpService conectado al BFF / API Gateway real
WIN_APP_USE_MOCK=false

# URL base para las peticiones HTTP al BFF / API
# En desarrollo local con proxy inverso se suele usar "/api/v1"
WIN_APP_API_URL=/api/v1

# Identificador de entorno (development | staging | production)
WIN_APP_ENV=development

# Nivel de logging en consola (debug | info | warn | error)
WIN_APP_LOG_LEVEL=debug
