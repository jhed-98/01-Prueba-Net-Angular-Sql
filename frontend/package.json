{
  "name": "win-services-web-template",
  "version": "1.0.0",
  "description": "Plantilla base empresarial para aplicaciones Frontend en Angular con arquitectura Feature-Driven y Spartan UI / Tailwind CSS",
  "scripts": {
    "ng": "ng",
    "env:sync": "node scripts/sync-env.mjs",
    "prestart": "npm run env:sync",
    "start": "ng serve",
    "prebuild": "npm run env:sync",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run env:sync",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.31.0",
    "@spartan-ng/brain": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@spartan-ng/cli": "^1.3.2",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
